            "date": "2025-05-02T07:15:00+00:00"
          },
          "parse": {
            "status": "ok",
            "confidence": 1.0,
            "missing_pages": [],
            "ocr_required_pages": [],
            "reason_codes": []
          },
          "source_set": "candidate",
          "excluded_matters": [],
          "spans": [
            {
              "span_id": "s-7adb9faa85648f58#1",
              "text": "Re: Licence check for the Grey Tern",
              "text_sha256": "1d2a6f1bc76535179349b9568ae01abfd5f9ddc04696ca2da6659accf2572206",
              "locator": {
                "kind": "email-body",
                "part": "subject",
                "start": 0,
                "end": 35
              },
              "quoted": false
            },
            {
              "span_id": "s-7adb9faa85648f58#2",
              "text": "The licence registry shows that the Grey Tern was moored without a mooring licence on the day of the patrol.",
              "text_sha256": "ffa7b2f1af6d1ac3d1ac96de092289f75a9afe730dd20e3c54a0dae79f7863b8",
              "locator": {
                "kind": "email-body",
                "part": "1",
                "start": 0,
                "end": 108
              },
              "quoted": false
            },
            {
              "span_id": "s-7adb9faa85648f58#3",
              "text": "The registry has no record of any licence application for that cutter.",
              "text_sha256": "ba6b08aa019e94182734c87ff2989e841d5045eb8fe533a623a033efb917b389",
              "locator": {
                "kind": "email-body",
                "part": "1",
                "start": 110,
                "end": 180
              },
              "quoted": false
            },
            {
              "span_id": "s-7adb9faa85648f58#4",
              "text": "On Fri, 02 May 2025 at 07:40, Patrol Office wrote:\n> Please check the licence position of the Grey Tern for the east quay.\n> The master told the officer that the paperwork was on board.",
              "text_sha256": "ae0682dafb654e5b59fc14d2282d7f8febbc415d23817ecd12568b19ae7c35be",
              "locator": {
                "kind": "email-body",
                "part": "1",
                "start": 182,
                "end": 367
              },
              "quoted": true
            }
          ]
        }
      ]
    },
