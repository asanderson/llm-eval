          "spans": [
            {
              "span_id": "s-587bb89ae3a31a1b#1",
              "text": "Town inspection report, Hollin Lane yard.",
              "text_sha256": "8e3be6670ed37b4feab81f566576e59e324bca4b3bbeba08285e5575ad35d293",
              "locator": {
                "kind": "text",
                "paragraph": 1,
                "start": 0,
                "end": 41
              }
            },
            {
              "span_id": "s-587bb89ae3a31a1b#2",
              "text": "The inspector saw that the respondent fired the kiln at the Hollin Lane yard after dusk.",
              "text_sha256": "3154679250be6983883d5496a275bbcbef4ccaa93249a1b27fab003cacd24d40",
              "locator": {
                "kind": "text",
                "paragraph": 2,
                "start": 43,
                "end": 131
              }
            },
            {
              "span_id": "s-587bb89ae3a31a1b#3",
              "text": "The yard lies inside the town limits according to the boundary map of the central district.",
              "text_sha256": "26bfee54060b7649852f1688dc06c67904022965f2b1963cdab9088e427369c1",
              "locator": {
                "kind": "text",
                "paragraph": 3,
                "start": 133,
                "end": 224
              }
            }
          ]
        },
        {
          "source_id": "s-c9d017744492c9df",
