          "source_set": "candidate",
          "excluded_matters": [],
          "spans": [
            {
              "span_id": "s-3b4d5fb6d712d5ef#1",
              "text": "Harbor patrol report, east quay.",
              "text_sha256": "0f945d3e8a64025066201b351ff318e4293fb92c27d049a4b10433986f79f69e",
              "locator": {
                "kind": "text",
                "paragraph": 1,
                "start": 0,
                "end": 32
              }
            },
            {
              "span_id": "s-3b4d5fb6d712d5ef#2",
              "text": "At first light the respondent moored the cutter Grey Tern alongside the east public quay.",
              "text_sha256": "52413ad97590376ea5845e95e351edeb485b89a35962e331a867d4403880b46e",
              "locator": {
                "kind": "text",
                "paragraph": 2,
                "start": 34,
                "end": 123
              }
            },
            {
              "span_id": "s-3b4d5fb6d712d5ef#3",
              "text": "The vessel stayed alongside for four hours while the crew mended nets on the quay.",
              "text_sha256": "2c5265828cc63a2603ff4b42b75ecf45b4333761a7000e1ec5477e8ac3a44c95",
              "locator": {
                "kind": "text",
                "paragraph": 3,
                "start": 125,
                "end": 207
              }
            }
          ]
        },
        {
          "source_id": "s-7adb9faa85648f58",
          "role": "evidence",
          "version": "1",
          "kind": "message",
          "original_sha256": "42f809235fbc560c6dc8b1533ce6c93742000f4aee63942978b793ce8fefaa7d",
          "original_bytes": 777,
          "media_type": "message/rfc822",
          "parent_source_id": null,
          "attachments": [],
          "email": {
            "message_id": "<p1-reply@harbor.veld.example>",
            "thread_id": "t-827faa5e1663",
