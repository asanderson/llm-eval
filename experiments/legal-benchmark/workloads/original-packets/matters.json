          "parse": {
            "status": "ok",
            "confidence": 1.0,
            "missing_pages": [],
            "ocr_required_pages": [],
            "reason_codes": []
          },
          "source_set": "candidate",
          "excluded_matters": [],
          "spans": [
            {
              "span_id": "s-c9d017744492c9df#1",
              "text": "Statement of a neighbour.",
              "text_sha256": "7751ae6845f824e79f8a37b64cca99da5a38fadd4fb3de1a444b376c0c7b4f5b",
              "locator": {
                "kind": "text",
                "paragraph": 1,
                "start": 0,
                "end": 25
              }
            },
            {
              "span_id": "s-c9d017744492c9df#2",
              "text": "The neighbour describes thick grey smoke over the lane for most of the evening.",
              "text_sha256": "c8f00802162447cce3a2127ddf00ea5c14afbb1dc3b93950deb7c2522a74a591",
