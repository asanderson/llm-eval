      "posture": "screening",
      "question": "Does the false entry in the ferry manifest support a charge?",
      "output_schema": "candidate-output-v1",
      "sources": [
        {
          "source_id": "f8-manifest-a-s1",
          "role": "evidence",
          "version": "1",
          "kind": "report",
          "spans": [
            {
              "span_id": "f8-manifest-a-s1#1",
              "text": "The purser entered forty passengers in the manifest.",
              "text_sha256": "a9b9bb77921371d2dd5392772bfa02125ee62621494a1a40fbd7b31f8770f9c8"
            },
            {
              "span_id": "f8-manifest-a-s1#2",
              "text": "The deck count shows the entry was false.",
              "text_sha256": "61fbb849cc8a582f5c5a489b6a2f62bce11397810b56e7f8edcaa287429410e9"
            }
          ]
        },
        {
          "source_id": "f8-manifest-a-s2",
          "role": "evidence",
          "version": "1",
          "kind": "statement",
          "spans": [
            {
              "span_id": "f8-manifest-a-s2#1",
              "text": "The purser admits he knew the count was lower.",
              "text_sha256": "31ae9bc7ddab2ecd0d5927a8a12a187ab195c519d298bf29e66c15721120caad"
            }
          ]
        },
        {
          "source_id": "f8-manifest-a-s3",
          "role": "evidence",
          "version": "1",
          "kind": "record",
          "spans": [
            {
              "span_id": "f8-manifest-a-s3#1",
              "text": "The purser produced the written order of the harbormaster directing the entry.",
              "text_sha256": "658edac8c3311d84a6df3deb0da807bc68aa24b3dc8ce0645941404b027b5a8c"
            }
          ]
        }
      ]
